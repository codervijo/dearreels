---
// src/pages/privacy.astro
//
// Privacy page (PRD v1.C), following mspproof.com's pattern: it covers the
// website only, because the Dearreels service is pre-launch. Every factual
// statement is derived from the code: SignupSection.tsx (form fields; posts to
// Web3Forms), the request form below, global.css (Google-hosted fonts), no
// analytics/cookies/storage anywhere in src/, Cloudflare Pages hosting.
// Update this page when any of those change, and expand it when the service
// launches.
//
// Use/no-sale and retention wording confirmed by the operator 2026-10-30.
// If a new operator commitment needs sign-off, wrap it in <Verify>, set
// verifyPending = true and add the path back to astro.config.mjs's filter.
import ContentLayout from "../layouts/ContentLayout.astro";

const path = "/privacy/";
const title = "Privacy Policy";
const description =
  "What Dearreels collects through this website, who processes it, and how to ask for access or deletion.";
const effective = "October 30, 2026";
const verifyPending = false;
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? "";

const field =
  "w-full rounded-md border border-input bg-background px-3 py-2 text-foreground font-normal";
---
<ContentLayout
  title={title}
  description={description}
  path={path}
  noindex={verifyPending}
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Privacy", path },
  ]}
>
  <article class="mx-auto max-w-3xl px-6 pt-10 pb-16">
    <h1 class="font-serif text-4xl leading-[1.1] tracking-tight md:text-5xl">Privacy Policy</h1>
    <p class="mt-4 text-sm text-muted-foreground">Effective {effective}</p>

    <div class="prose-dr mt-10">
      <p>
        This page covers the dearreels.com website. Dearreels is a
        <a href="https://lamill.io">lamill.io</a> project, and the Dearreels
        service is pre-launch: nothing on this site sends prompts to anyone or
        stores replies. We'll expand this page before the service launches.
      </p>

      <h2>What we collect</h2>
      <ul>
        <li>
          <strong>Sign-ups.</strong> The sign-up form asks for your name, your
          email, and, optionally, a few words about the parent you have in mind.
        </li>
        <li>
          <strong>Privacy requests.</strong> The form on this page asks for your
          email, the type of request, and a message.
        </li>
        <li>
          <strong>No analytics.</strong> This site runs no analytics or
          advertising trackers, sets no cookies, and stores nothing in your browser.
        </li>
      </ul>

      <h2>Who processes it</h2>
      <ul>
        <li>
          <strong>Cloudflare</strong> hosts the site and handles standard request
          data, such as IP address and browser type, to deliver pages and block abuse.
        </li>
        <li>
          <strong>Web3Forms</strong> receives form submissions and forwards them
          to us by email.
        </li>
        <li>
          <strong>Google Fonts</strong> serves the Fraunces and Inter typefaces, so
          your browser contacts Google's servers, which may log your IP address.
        </li>
      </ul>

      <h2>How we use it</h2>
      <p>
        We use form submissions to reply to you and, for sign-ups, to write back
        about setting up Dearreels for your family. We do not sell personal
        information or share it for advertising.
      </p>

      <h2>Retention and deletion</h2>
      <p>
        We don't keep a database of submissions. Each one arrives as an email in
        our inbox. Ask and we'll tell you what we have, correct it, or delete it.
      </p>

      <h2>Make a request</h2>
      <p>
        Use this form for access, correction, deletion, or any other privacy
        question, or write to <a href="mailto:hello@lamill.io">hello@lamill.io</a>.
      </p>
    </div>

    <form id="privacy-form" class="mt-6 flex flex-col gap-4" data-key={web3formsKey}>
      <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
      <label class="flex flex-col gap-1.5 text-sm font-medium">
        <span>Email</span>
        <input type="email" name="email" required autocomplete="email" class={field} />
      </label>
      <label class="flex flex-col gap-1.5 text-sm font-medium">
        <span>Request</span>
        <select name="request_type" required class={field}>
          <option value="access">See what you hold about me</option>
          <option value="correction">Correct my information</option>
          <option value="deletion">Delete my information</option>
          <option value="other">Other question</option>
        </select>
      </label>
      <label class="flex flex-col gap-1.5 text-sm font-medium">
        <span>Message</span>
        <textarea name="message" rows="4" required class={field}></textarea>
      </label>
      <button
        type="submit"
        class="self-start rounded-full bg-primary px-5 py-2.5 text-sm text-primary-foreground transition hover:opacity-90 disabled:opacity-60"
      >
        Send request
      </button>
      <p class="form-status text-sm" role="status" aria-live="polite"></p>
    </form>

    <div class="prose-dr mt-10">
      <h2>Changes</h2>
      <p>If this page changes, the effective date above changes with it.</p>
    </div>
  </article>
</ContentLayout>

<script>
  // Posts to Web3Forms; shows success only after the service confirms, and
  // errors (never fakes success) when the access key is unset.
  const form = document.getElementById("privacy-form") as HTMLFormElement | null;
  const status = form?.querySelector(".form-status") as HTMLElement | null;
  const button = form?.querySelector("button[type=submit]") as HTMLButtonElement | null;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!status || !button) return;
    const key = form.dataset.key;
    if (!key) {
      status.textContent = "Requests can't be submitted right now. Please write to hello@lamill.io instead.";
      return;
    }
    const data = new FormData(form);
    data.append("access_key", key);
    data.append("subject", "Dearreels privacy request");
    data.append("from_name", "Dearreels privacy form");
    button.disabled = true;
    status.textContent = "Sending…";
    try {
      const res = await fetch("https://api.web3forms.com/submit", { method: "POST", body: data });
      const json = await res.json();
      if (json.success) {
        form.reset();
        status.textContent = "Request received. We'll reply by email.";
      } else {
        status.textContent = json.message || "Something went wrong. Please try again.";
      }
    } catch {
      status.textContent = "Network error. Please try again in a moment.";
    } finally {
      button.disabled = false;
    }
  });
</script>
